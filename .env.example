# BillFlow Environment Variables
# Port automatically injected by Render (defaults to 3000 for local dev)
PORT=3000

# Node environment (production on Render, development for local work)
NODE_ENV=production

# Google Gemini API key for AI smart billing features (server-side only, optional)
GEMINI_API_KEY=

# Persistent Data Storage Directory (for Render Persistent Disk mount, e.g., /var/data)
# If left empty, defaults to repository directory
DATA_DIR=
